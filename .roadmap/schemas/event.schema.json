{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESAA Event",
  "description": "Schema do envelope de evento do audit. Escopado por (tenant_id, cnpj) — ver ADR-002 e ADR-003.",
  "type": "object",
  "required": [
    "event_id",
    "event_seq",
    "action",
    "task_id",
    "actor",
    "ts",
    "schema_version",
    "tenant_id",
    "cnpj",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUID v4)"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Sequência monotônica e sem gaps DENTRO do par (tenant_id, cnpj); não é global"
    },
    "action": {
      "type": "string",
      "enum": [
        "run.start",
        "task.create",
        "claim",
        "complete",
        "review",
        "issue.report",
        "hotfix.create",
        "output.rejected",
        "verify.start",
        "verify.ok",
        "verify.fail",
        "orchestrator.file.write",
        "phase.complete"
      ],
      "description": "Event action from controlled vocabulary"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Task identifier (e.g., T-1000)"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "Agent or orchestrator that emitted this event"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "schema_version": {
      "type": "string",
      "const": "0.4.0",
      "description": "ESAA schema version"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Escritório (tenant) dono do evento"
    },
    "cnpj": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "description": "CNPJ do cliente, 14 dígitos sem máscara"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "Competência YYYY-MM. Ausente quando o evento é do CNPJ e não de um mês (ex.: client.enrolled)"
    },
    "payload": {
      "type": "object",
      "description": "Action-specific payload data"
    }
  },
  "additionalProperties": false
}
