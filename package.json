{
  "name": "audit",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "verify": "tsx src/cli/audit.ts verify",
    "sql:bundle": "tsx scripts/gerar-sql-completo.ts",
    "doctor": "tsx src/cli/audit.ts doctor",
    "pooler": "tsx scripts/descobrir-pooler.ts",
    "start": "node dist/cli/audit.js serve",
    "serve": "tsx src/cli/audit.ts serve"
  },
  "keywords": [
    "reforma-tributaria",
    "ibs",
    "cbs",
    "event-sourcing",
    "fiscal",
    "nfe",
    "apuracao"
  ],
  "author": "",
  "license": "ISC",
  "description": "audit — motor de conciliação da transição tributária (SaaS fiscal sobre o kernel ESAA-Flow de event sourcing)",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xmldom/xmldom": "^0.9.12",
    "form-data": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "xml-crypto": "^6.3.1"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "audit": "dist/cli/audit.js"
  }
}
