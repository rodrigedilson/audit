# =============================================================================
# audit — variáveis de ambiente
#
# Copie para .env e preencha. O .env é ignorado pelo git; nunca comite segredo.
# A API não sobe com uma obrigatória ausente: falhar no start é melhor que
# falhar na primeira requisição, e muito melhor que aceitar qualquer token.
# =============================================================================

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Origens liberadas no CORS, separadas por vírgula. Sem valor, só o Vite local é
# aceito — o default nunca é '*', porque o produto custodia certificado digital
# de terceiros.
CORS_ORIGINS=http://localhost:5173,https://SEU-APP.lovable.app

# --- Banco (obrigatória) ---
# Supabase: Project Settings → Database → Connection string (URI).
# Use o pooler (porta 6543) para a API e a conexão direta (5432) para migrations.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Supabase Auth (obrigatórias) ---
# Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-ANON

# Material de verificação do JWT: um dos dois é obrigatório.
# HS256 (Project Settings → API → JWT Secret):
SUPABASE_JWT_SECRET=SEU-JWT-SECRET
# Ou chaves assimétricas, e aí deixe o secret vazio:
# SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json

SUPABASE_JWT_AUDIENCE=authenticated

# A service role ignora RLS e é usada pelos jobs de backend. Nunca exponha ao
# frontend, e não a use no caminho de requisição do usuário.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Cofre de certificados A1 (obrigatória) ---
# Cifra o PFX do cliente em repouso (AES-256-GCM). Fica FORA do banco: guardá-la
# junto do dado que ela protege anularia a cifragem. Mínimo 32 caracteres.
#   openssl rand -base64 48
# Trocar esta chave torna ilegíveis os certificados já guardados — planeje
# rotação antes de trocar.
CERTIFICATE_MASTER_KEY=

# --- Cobrança: Asaas (opcional até a cobrança entrar no ar) ---
# Sem ASAAS_API_KEY a API sobe e a cobrança roda em modo "só cálculo": planos,
# calculadora pública e prévia de fatura funcionam, e nada é enviado ao gateway.
# Sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token que o Asaas envia no cabeçalho `asaas-access-token`. Sem ele o webhook
# responde 503 em vez de ficar aberto — um POST anônimo poderia marcar fatura
# como paga.
# ASAAS_WEBHOOK_TOKEN=

# --- Testes ---
# Sem esta variável, a suíte do adapter Postgres é pulada.
# TEST_DATABASE_URL=postgres://audit:audit@localhost:55432/audit_test
