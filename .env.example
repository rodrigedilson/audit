# =============================================================================
# audit — variáveis de ambiente
#
# Copie para .env e preencha. O .env é ignorado pelo git; nunca comite segredo.
# A API não sobe com uma obrigatória ausente: falhar no start é melhor que
# falhar na primeira requisição, e muito melhor que aceitar qualquer token.
# =============================================================================

# --- Ambiente (obrigatória) ---
# `dev` ou `prod`, sem padrão. Em prod a API não sobe sem CORS_ORIGINS nem, com
# chave do Asaas, sem ASAAS_BASE_URL de produção e ASAAS_WEBHOOK_TOKEN. Em dev
# ela recusa o Asaas de produção. O banco e o projeto Supabase são os mesmos nos
# dois ambientes.
AUDIT_ENV=dev

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Origens liberadas no CORS, separadas por vírgula. Sem valor, só o Vite local é
# aceito — o default nunca é '*', porque o produto custodia certificado digital
# de terceiros. Obrigatória com AUDIT_ENV=prod.
CORS_ORIGINS=http://localhost:5173,https://SEU-APP.lovable.app

# --- Banco (obrigatória) ---
#
# EVITE a "Direct connection" (db.SEU-REF.supabase.co): esse host tem apenas
# endereço IPv6, e máquina sem rota IPv6 — WSL em modo NAT, por exemplo — falha
# com ENETUNREACH. Os hosts *.pooler.supabase.com atendem em IPv4.
#
# O hostname do pooler NÃO é previsível: o prefixo varia entre `aws-0` e `aws-1`
# e a região não aparece em lugar público. Descubra o seu com:
#
#   npm run pooler -- SEU-REF
#
# ou copie de Supabase → Connect → Session pooler.
#
# Repare que no pooler o usuário vira `postgres.<project-ref>`.
# URL-encode de caracteres especiais na senha: @ = %40, # = %23, : = %3A.
DATABASE_URL=postgresql://postgres.SEU-REF:SENHA@aws-N-SUA-REGIAO.pooler.supabase.com:5432/postgres

# --- Supabase Auth (obrigatórias) ---
# Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-ANON

# Material de verificação do JWT: um dos dois é obrigatório.
#
# Projetos novos do Supabase usam chaves ASSIMÉTRICAS (ES256) e não têm segredo
# compartilhado — verifique em /auth/v1/.well-known/jwks.json: se devolver uma
# chave, use o JWKS. É a opção preferível: não há segredo a vazar, e a rotação
# de chave fica transparente para a API.
SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
#
# Projetos com o segredo legado HS256 (Project Settings → API → JWT Secret)
# usam isto no lugar:
# SUPABASE_JWT_SECRET=SEU-JWT-SECRET

SUPABASE_JWT_AUDIENCE=authenticated

# A service role ignora RLS e é usada pelos jobs de backend. Nunca exponha ao
# frontend, e não a use no caminho de requisição do usuário.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Cofre de certificados A1 (obrigatória) ---
# Cifra o PFX do cliente em repouso (AES-256-GCM). Fica FORA do banco: guardá-la
# junto do dado que ela protege anularia a cifragem. Mínimo 32 caracteres.
#   openssl rand -base64 48
# Trocar esta chave torna ilegíveis os certificados já guardados — planeje
# rotação antes de trocar.
CERTIFICATE_MASTER_KEY=

# --- Cobrança: Asaas (opcional até a cobrança entrar no ar) ---
# Sem ASAAS_API_KEY a API sobe e a cobrança roda em modo "só cálculo": planos,
# calculadora pública e prévia de fatura funcionam, e nada é enviado ao gateway.
#
# dev:  sandbox, https://api-sandbox.asaas.com/v3 (é o padrão sem ASAAS_BASE_URL).
#       A URL de produção é recusada.
# prod: ASAAS_BASE_URL=https://api.asaas.com/v3 obrigatória junto da chave —
#       sem ela a cobrança iria para o sandbox sem erro nenhum.
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token que o Asaas envia no cabeçalho `asaas-access-token`. Sem ele o webhook
# responde 503 em vez de ficar aberto — um POST anônimo poderia marcar fatura
# como paga.
# ASAAS_WEBHOOK_TOKEN=

# --- Assistente fiscal, camada 3 (opcional) ---
# Sem a chave, o assistente responde só as perguntas da lista (consulta
# determinística, com citação) e diz "não sei" para o resto. Com ela, pergunta
# fora da lista vai para o modelo, que responde só sobre os fatos que essas
# consultas trouxeram, e cada afirmação passa pela mesma checagem de citação.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5

# --- Testes ---
# Sem esta variável, a suíte do adapter Postgres é pulada.
# Fora do CI, a suíte não usa este banco direto: cria e usa `audit_test_<hash>`,
# um por conjunto de migrations, para o schema de uma branch não vazar para as
# outras worktrees. Para limpar os antigos: `drop database "audit_test_<hash>"`.
# TEST_DATABASE_URL=postgres://audit:audit@localhost:55432/audit_test

# --- Rede e superfície pública -------------------------------------------
# Confiar no X-Forwarded-For. OBRIGATÓRIO em produção, onde a API fica atrás de
# proxy (Supabase, Fly, Cloudflare): sem isso todo visitante chega com o IP do
# proxy, e a quota do diagnóstico público vira um balde único que bloqueia todo
# mundo depois dos primeiros acessos. Ligar sem proxy na frente é pior — permite
# forjar o IP por cabeçalho —, por isso o padrão é false.
TRUST_PROXY=false

# Killswitch do diagnóstico público (POST /v1/reform-readiness). A rota é anônima
# e o parsing de XML é CPU-bound; precisa poder ser desligada por variável, sem
# rollback. Padrão: ligado.
PUBLIC_DIAGNOSTIC_ENABLED=true

# --- E-mail do diagnóstico público (opcional) ---
# O relatório sai por SMTP: o servidor do domínio próprio ou qualquer serviço que
# aceite SMTP. As três vão juntas (o e-mail leva o link de remoção, que usa a
# URL pública). Sem elas o lead é gravado e a resposta diz que o e-mail não saiu.
# smtps:// na 465 (TLS direto) ou smtp:// na 587 (STARTTLS); @ no usuário = %40.
# MAIL_SMTP_URL=smtps://diagnostico%40seu-dominio.com.br:SENHA@smtp.seu-provedor.com:465
# MAIL_FROM=Diagnóstico <diagnostico@seu-dominio.com.br>
# PUBLIC_API_URL=https://SUA-API.onrender.com
#
# Chave própria do resumo guardado por até 24h para o envio (não é a do cofre).
# Sem ela nada é guardado. Mínimo 32 caracteres: openssl rand -base64 48
# REPORT_ENCRYPTION_KEY=
# Segredo do HMAC do IP do visitante. Sem ele o hash deriva da chave do cofre.
# IP_HASH_SECRET=
